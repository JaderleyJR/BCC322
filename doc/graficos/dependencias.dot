  "test/unit/main.cpp" -> "test/unit/unit_ServicoAutenticacao.h";
  "test/unit/main.cpp" -> "test/unit/unit_ServicoAcesso.h";
  "test/unit/main.cpp" -> "test/unit/unit_ServicoOfertas.h";
  "test/unit/main.cpp" -> "test/unit/unit_ServicoReservas.h";
  "test/unit/main.cpp" -> "test/unit/unit_ServicoRetiradas.h";
  "test/unit/main.cpp" -> "test/unit/unit_ServicoIndicadores.h";
  "test/unit/unit_Oferta.cpp" -> "test/unit/unit_Oferta.h";
