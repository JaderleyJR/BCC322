    "test/unit/unit_ServicoOfertas.cpp" [label="unit_ServicoOfertas.cpp", fillcolor="#fef3c7"];
    "test/unit/unit_ServicoOfertas.h" [label="unit_ServicoOfertas.h", fillcolor="#fef3c7"];
    "test/unit/unit_ServicoReservas.cpp" [label="unit_ServicoReservas.cpp", fillcolor="#fef3c7"];
    "test/unit/unit_ServicoReservas.h" [label="unit_ServicoReservas.h", fillcolor="#fef3c7"];
    "test/unit/unit_ServicoRetiradas.cpp" [label="unit_ServicoRetiradas.cpp", fillcolor="#fef3c7"];
    "test/unit/unit_ServicoRetiradas.h" [label="unit_ServicoRetiradas.h", fillcolor="#fef3c7"];
    "test/unit/unit_Sessao.cpp" [label="unit_Sessao.cpp", fillcolor="#fef3c7"];
    "test/unit/unit_Sessao.h" [label="unit_Sessao.h", fillcolor="#fef3c7"];
    "test/unit/unit_SistemaSaveFood.cpp" [label="unit_SistemaSaveFood.cpp", fillcolor="#fef3c7"];
    "test/unit/unit_SistemaSaveFood.h" [label="unit_SistemaSaveFood.h", fillcolor="#fef3c7"];
    "test/unit/unit_Usuario.cpp" [label="unit_Usuario.cpp", fillcolor="#fef3c7"];
    "test/unit/unit_Usuario.h" [label="unit_Usuario.h", fillcolor="#fef3c7"];
    "test/unit/unit_tests.cpp" [label="unit_tests.cpp", fillcolor="#fef3c7"];
    "test/unit/unit_tests.h" [label="unit_tests.h", fillcolor="#fef3c7"];
  }
  subgraph "cluster_test/funcional" { label="Testes funcionais (test/funcional)"; color="#cbd5e1";
    "test/funcional/funcional_tests.cpp" [label="funcional_tests.cpp", fillcolor="#dcfce7"];
    "test/funcional/funcional_tests.h" [label="funcional_tests.h", fillcolor="#dcfce7"];
