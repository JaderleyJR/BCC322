digraph Dependencias {
  graph [rankdir=LR, bgcolor="white", pad=.3, nodesep=.18, ranksep=.9, fontname="Arial", label="SaveFood - Dependencias entre arquivos", labelloc=t, fontsize=18];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10, color="#64748b"];
  edge [color="#94a3b8", arrowsize=.6];
  subgraph "cluster_src" { label="Produto (src)"; color="#cbd5e1";
    "src/flow.cpp" [label="flow.cpp", fillcolor="#dbeafe"];
    "src/flow.h" [label="flow.h", fillcolor="#dbeafe"];
    "src/main.cpp" [label="main.cpp", fillcolor="#dbeafe"];
    "src/model.cpp" [label="model.cpp", fillcolor="#dbeafe"];
    "src/model.h" [label="model.h", fillcolor="#dbeafe"];
    "src/services.cpp" [label="services.cpp", fillcolor="#dbeafe"];
    "src/services.h" [label="services.h", fillcolor="#dbeafe"];
    "src/system.cpp" [label="system.cpp", fillcolor="#dbeafe"];
    "src/system.h" [label="system.h", fillcolor="#dbeafe"];
  }
  subgraph "cluster_test/unit" { label="Testes unitarios (test/unit)"; color="#cbd5e1";
    "test/unit/main.cpp" [label="main.cpp", fillcolor="#fef3c7"];
    "test/unit/unit_Oferta.cpp" [label="unit_Oferta.cpp", fillcolor="#fef3c7"];
    "test/unit/unit_Oferta.h" [label="unit_Oferta.h", fillcolor="#fef3c7"];
    "test/unit/unit_Reserva.cpp" [label="unit_Reserva.cpp", fillcolor="#fef3c7"];
    "test/unit/unit_Reserva.h" [label="unit_Reserva.h", fillcolor="#fef3c7"];
    "test/unit/unit_Restaurante.cpp" [label="unit_Restaurante.cpp", fillcolor="#fef3c7"];
    "test/unit/unit_Restaurante.h" [label="unit_Restaurante.h", fillcolor="#fef3c7"];
    "test/unit/unit_ResumoIndicadores.cpp" [label="unit_ResumoIndicadores.cpp", fillcolor="#fef3c7"];
    "test/unit/unit_ResumoIndicadores.h" [label="unit_ResumoIndicadores.h", fillcolor="#fef3c7"];
    "test/unit/unit_ServicoAcesso.cpp" [label="unit_ServicoAcesso.cpp", fillcolor="#fef3c7"];
    "test/unit/unit_ServicoAcesso.h" [label="unit_ServicoAcesso.h", fillcolor="#fef3c7"];
    "test/unit/unit_ServicoAutenticacao.cpp" [label="unit_ServicoAutenticacao.cpp", fillcolor="#fef3c7"];
    "test/unit/unit_ServicoAutenticacao.h" [label="unit_ServicoAutenticacao.h", fillcolor="#fef3c7"];
    "test/unit/unit_ServicoIndicadores.cpp" [label="unit_ServicoIndicadores.cpp", fillcolor="#fef3c7"];
