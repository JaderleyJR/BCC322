digraph Dependencias {
  graph [rankdir=LR, bgcolor="white", pad=.3, nodesep=.15, ranksep=1.0, fontname="Arial", label="SaveFood - Dependencias entre arquivos", labelloc=t, fontsize=18];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10, color="#64748b"];
  edge [color="#94a3b8", arrowsize=.6];
  subgraph "cluster_src" { label="Apresentacao (src)"; color="#cbd5e1";
    "src/exportacao.h" [label="exportacao.h", fillcolor="#e2e8f0"];
    "src/main.cpp" [label="main.cpp", fillcolor="#e2e8f0"];
  }
  subgraph "cluster_src/apresentacao" { label="Apresentacao (src/apresentacao)"; color="#cbd5e1";
    "src/apresentacao/flow.cpp" [label="flow.cpp", fillcolor="#e2e8f0"];
    "src/apresentacao/flow.h" [label="flow.h", fillcolor="#e2e8f0"];
  }
