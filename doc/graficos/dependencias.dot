    "src/nucleo/system.h" [label="system.h", fillcolor="#bfdbfe"];
  }
  subgraph "cluster_src/dominio" { label="Dominio (src/dominio)"; color="#cbd5e1";
    "src/dominio/model.cpp" [label="model.cpp", fillcolor="#fde68a"];
    "src/dominio/model.h" [label="model.h", fillcolor="#fde68a"];
  }
  subgraph "cluster_test/unit" { label="Testes unitarios"; color="#cbd5e1";
    "test/unit/main.cpp" [label="main.cpp", fillcolor="#fef3c7"];
