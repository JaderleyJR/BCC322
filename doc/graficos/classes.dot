digraph Classes {
  graph [rankdir=LR, bgcolor="white", pad=.25, nodesep=.24, ranksep=.65, fontname="Arial", fontsize=18, label="SaveFood - Estrutura de classes", labelloc=t];
  node [shape=record, style=filled, fillcolor="#f1f5f9", color="#64748b", fontname="Arial", fontsize=10];
  edge [color="#64748b", fontname="Arial", fontsize=9, arrowsize=.65];
  SistemaSaveFood [label="{SistemaSaveFood|mutex_\lrestaurantes_\lusuarios_\lofertas_\lreservas_\lsessoesAtivas_\l|entrar() / sair()\lpublicarOferta()\lreservar() / cancelarReserva()\lconfirmarRetirada()\lobterResumo()\l}", fillcolor="#dbeafe"];
  Restaurante [label="{Restaurante|id_\lnome_\l}", fillcolor="#f1f5f9"];
  Usuario [label="{Usuario|id_\lemail_\lperfil_\lidRestaurante_\l}", fillcolor="#f1f5f9"];
  Sessao [label="{Sessao|codigo_\lidUsuario_\lativa_\l}", fillcolor="#f1f5f9"];
  Oferta [label="{Oferta|id_ / idRestaurante_\lquantidadeTotal_\lquantidadeDisponivel_\l|reservar()\lrestaurarDisponibilidade()\l}", fillcolor="#f1f5f9"];
  Reserva [label="{Reserva|id_ / idOferta_\lidConsumidor_\lsituacao_\l|cancelar()\lconfirmarRetirada()\l}", fillcolor="#f1f5f9"];
  ResumoIndicadores [label="{ResumoIndicadores|pesoAproveitadoKg\lreceitaBrutaReais\l}", fillcolor="#f1f5f9"];
  DadosOferta [label="{DadosOferta|descricao\lquantidade\lpesoTotalKg\lprecoUnitario\ljanelaRetirada\l}", fillcolor="#f1f5f9"];
  FiltroOferta [label="{FiltroOferta|termo\l}", fillcolor="#f1f5f9"];
  DadosRetirada [label="{DadosRetirada|quantidadeEntregue\lpesoAproveitadoKg\lvalorRecebido\l}", fillcolor="#f1f5f9"];
  ServicoAutenticacao [label="{ServicoAutenticacao|entrar() / sair()\l}", fillcolor="#dcfce7"];
  ServicoAcesso [label="{ServicoAcesso|permitir()\l}", fillcolor="#dcfce7"];
  ServicoOfertas [label="{ServicoOfertas|publicar()\lconsultar()\ldetalhes()\l}", fillcolor="#dcfce7"];
  ServicoReservas [label="{ServicoReservas|reservar()\lcancelar()\lminhasReservas()\l}", fillcolor="#dcfce7"];
  ServicoRetiradas [label="{ServicoRetiradas|listar()\lconfirmar()\l}", fillcolor="#dcfce7"];
  ServicoIndicadores [label="{ServicoIndicadores|obterResumo()\l}", fillcolor="#dcfce7"];
  ServicoAutenticacao -> SistemaSaveFood [label="sistema_", arrowhead=vee];
  ServicoAcesso -> SistemaSaveFood [label="sistema_", arrowhead=vee];
  ServicoOfertas -> SistemaSaveFood [label="sistema_", arrowhead=vee];
  ServicoOfertas -> Sessao [label="sessao_", dir=both, arrowtail=diamond, arrowhead=none];
  ServicoReservas -> SistemaSaveFood [label="sistema_", arrowhead=vee];
  ServicoReservas -> Sessao [label="sessao_", dir=both, arrowtail=diamond, arrowhead=none];
  ServicoRetiradas -> SistemaSaveFood [label="sistema_", arrowhead=vee];
  ServicoRetiradas -> Sessao [label="sessao_", dir=both, arrowtail=diamond, arrowhead=none];
  ServicoIndicadores -> SistemaSaveFood [label="sistema_", arrowhead=vee];
  ServicoIndicadores -> Sessao [label="sessao_", dir=both, arrowtail=diamond, arrowhead=none];
  SistemaSaveFood -> Restaurante [label="0..N", dir=both, arrowtail=diamond, arrowhead=none];
  SistemaSaveFood -> Usuario [label="0..N", dir=both, arrowtail=diamond, arrowhead=none];
  SistemaSaveFood -> Oferta [label="0..N", dir=both, arrowtail=diamond, arrowhead=none];
  SistemaSaveFood -> Reserva [label="0..N", dir=both, arrowtail=diamond, arrowhead=none];
  SistemaSaveFood -> ResumoIndicadores [style=dashed, arrowhead=vee];
  ServicoOfertas -> DadosOferta [style=dashed, arrowhead=vee];
  ServicoOfertas -> FiltroOferta [style=dashed, arrowhead=vee];
  ServicoRetiradas -> DadosRetirada [style=dashed, arrowhead=vee];
  ServicoIndicadores -> ResumoIndicadores [style=dashed, arrowhead=vee];
}
